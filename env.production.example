# EnrollAssess Production Environment Configuration
# Copy this file to .env and update values for your Digital Ocean deployment

# Application Configuration
APP_NAME="EnrollAssess"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

# Database Configuration (Digital Ocean Managed MySQL)
DB_CONNECTION=mysql
DB_HOST=your-db-cluster-do-user-123456-0.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=doadmin
DB_PASSWORD=your-database-password
DB_SSL_MODE=require

# Cache Configuration (Digital Ocean Managed Redis)
CACHE_STORE=redis
CACHE_PREFIX=enrollassess-cache-

# Redis Configuration (Digital Ocean Managed Redis)
REDIS_HOST=your-redis-cluster-do-user-123456-0.db.ondigitalocean.com
REDIS_PASSWORD=your-redis-password
REDIS_PORT=25061
REDIS_DB=0
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_PREFIX=enrollassess-cache-

# Session Configuration (Redis for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue Configuration (Redis for production)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Mail Configuration (Production SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Broadcasting Configuration (Pusher for real-time features)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-key
PUSHER_APP_SECRET=your-pusher-secret
PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_APP_HOST}"
VITE_PUSHER_PORT="${PUSHER_APP_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_APP_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Performance Configuration
CACHE_AUTO_WARMUP=true
CACHE_INVALIDATION_STRATEGY=conservative
DB_ENABLE_QUERY_LOG=false
DB_MAX_QUERY_LOG_SIZE=100
DB_SLOW_QUERY_THRESHOLD=1000
DB_ENABLE_EAGER_LOADING=true
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30

# Monitoring Configuration
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_REPORT_FREQUENCY=daily
PERFORMANCE_REPORT_RECIPIENTS=admin@your-domain.com
PERFORMANCE_AUTO_REPORTS=false

# Pagination Configuration
PAGINATION_DEFAULT_PER_PAGE=15
PAGINATION_MAX_PER_PAGE=100
PAGINATION_ENABLE_CURSOR=false

# Search Configuration
SEARCH_MIN_LENGTH=2
SEARCH_ENABLE_FULL_TEXT=false
SEARCH_CACHE_DURATION=300

# Asset Optimization
ASSETS_ENABLE_COMPRESSION=true
ASSETS_ENABLE_BROWSER_CACHE=true
ASSETS_CACHE_DURATION=31536000

# Security Configuration
BCRYPT_ROUNDS=12
HASH_VERIFY=true

# File Storage (Digital Ocean Spaces - Optional)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=your-spaces-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret
AWS_DEFAULT_REGION=nyc3
AWS_BUCKET=your-bucket-name
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Additional Production Settings
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false


