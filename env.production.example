# EnrollAssess Production Environment Configuration
# Copy this file to .env and update values for your Digital Ocean deployment

# Application Configuration
APP_NAME="EnrollAssess"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# Database Configuration (On-Server MySQL - $24/month setup)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enrollassess
DB_USERNAME=enrollassess_user
DB_PASSWORD=your-strong-database-password
# DB_SSL_MODE=require  # Not needed for local MySQL

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=enrollassess-cache-

# Redis Configuration (On-Server Redis - $24/month setup)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_PREFIX=enrollassess-cache-

# Session Configuration (Redis for production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue Configuration (Redis for production)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Mail Configuration (Amazon SES - Recommended for Production)
# Note: Your system uses database configuration (admin panel) for email settings
# These .env values are optional defaults
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=bossy8770@gmail.com
MAIL_FROM_NAME="EnrollAssess System"

# AWS SES Credentials (configured in admin panel, but can set defaults here)
# Leave empty - will be configured in admin panel → Settings → Email
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1

# Broadcasting Configuration (Pusher for real-time features)
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=2068662
PUSHER_APP_KEY=f11dc48551a0d1842558
PUSHER_APP_SECRET=794ff79fd90a1c8fe963
PUSHER_APP_CLUSTER=ap1

# Frontend configuration
VITE_BROADCAST_DRIVER=pusher
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_APP_NAME="${APP_NAME}"

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Redis Client
REDIS_CLIENT=phpredis

# Performance Configuration
CACHE_AUTO_WARMUP=true
CACHE_INVALIDATION_STRATEGY=conservative
DB_ENABLE_QUERY_LOG=false
DB_MAX_QUERY_LOG_SIZE=100
DB_SLOW_QUERY_THRESHOLD=1000
DB_ENABLE_EAGER_LOADING=true
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30

# Monitoring Configuration
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_REPORT_FREQUENCY=daily
PERFORMANCE_REPORT_RECIPIENTS=admin@your-domain.com
PERFORMANCE_AUTO_REPORTS=false

# Pagination Configuration
PAGINATION_DEFAULT_PER_PAGE=15
PAGINATION_MAX_PER_PAGE=100
PAGINATION_ENABLE_CURSOR=false

# Search Configuration
SEARCH_MIN_LENGTH=2
SEARCH_ENABLE_FULL_TEXT=false
SEARCH_CACHE_DURATION=300

# Asset Optimization
ASSETS_ENABLE_COMPRESSION=true
ASSETS_ENABLE_BROWSER_CACHE=true
ASSETS_CACHE_DURATION=31536000

# Security Configuration
BCRYPT_ROUNDS=12
HASH_VERIFY=true

# Memcached (if using instead of Redis)
MEMCACHED_HOST=127.0.0.1

# File Storage
FILESYSTEM_DISK=local
# AWS credentials above are for SES, not for file storage
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Additional Production Settings
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false


